# ==============================================================================
# Zanzirangi House - Environment Configuration Template
# ==============================================================================
# SECURITY NOTICE:
# - Never commit real values, passwords, or secrets to Git.
# - Never place DB_PASSWORD in source code, tests, docs, or frontend.
# - For local development: DATABASE_PROVIDER=json (default)
# - For Hostinger production: configure these directly in hPanel -> Node.js Web App
# ==============================================================================

NODE_ENV=production
DATABASE_PROVIDER=mysql

# Hostinger MySQL Database Configuration
DB_HOST=srv982.hstgr.io
DB_PORT=3306
DB_NAME=u170555096_Zanzirangi
DB_USER=u170555096_admindatabase
DB_PASSWORD=<SET_IN_HOSTINGER_ENVIRONMENT>
PORT=<HOSTINGER_ASSIGNED_PORT>

# Session Authentication & JWT
JWT_SECRET=<SET_IN_HOSTINGER_ENVIRONMENT>
JWT_EXPIRES_IN=7d

# Application Routing & URLs (Same-Origin Architecture)
APP_URL=https://zanzirangihouse.com
PUBLIC_URL=https://zanzirangihouse.com
API_URL=https://zanzirangihouse.com/api

# Security & CORS (Use specific production origin, never *)
CORS_ORIGIN=https://zanzirangihouse.com

# Media Storage (Uploaded files stored outside frontend build output)
MEDIA_STORAGE_PATH=./uploads
MAX_UPLOAD_SIZE=25
LOG_LEVEL=info
