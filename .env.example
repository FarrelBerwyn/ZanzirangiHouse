# ==============================================================================
# Zanzirangi House - Environment Configuration Template
# ==============================================================================
# SECURITY NOTICE:
# - Never commit real values, passwords, or secrets to Git.
# - Production: set these in hPanel -> Websites -> Node.js -> Environment variables.
#   Platform variables are authoritative: the server never lets a .env file override them,
#   and .env.local is ignored when NODE_ENV=production.
# - Local development: copy to .env (and optionally .env.local for personal overrides).
# ==============================================================================

# Required in production. Must be exactly "production" on Hostinger.
NODE_ENV=production
# Production always uses MySQL (there is no JSON fallback in production).
DATABASE_PROVIDER=mysql

# MySQL — from the deployed app use 127.0.0.1 (the srvNNNN.hstgr.io host is for remote access only)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=<database-name>
DB_USER=<database-user>
DB_PASSWORD=<database-password>

# Optional: Hostinger provides the port to the Node runtime; 3000 is used when unset.
# PORT=3000

# Session Authentication (JWT_SECRET: random, at least 32 characters)
JWT_SECRET=<random-secret-min-32-chars>
JWT_EXPIRES_IN=7d

# Application URLs (same-origin architecture)
APP_URL=https://zanzirangihouse.com
PUBLIC_URL=https://zanzirangihouse.com
API_URL=https://zanzirangihouse.com/api

# CORS (use the exact production origin, never *)
CORS_ORIGIN=https://zanzirangihouse.com

# Media storage. Default in production: <app-dir>/../zanzirangi-media (outside the deployed
# app directory, so uploads survive redeploys). Set an absolute path to override.
# MEDIA_STORAGE_PATH=/home/<user>/domains/zanzirangihouse.com/zanzirangi-media
MAX_UPLOAD_SIZE=25
LOG_LEVEL=info

# Hostinger SMTP Email Configuration (Instant alerts for villa bookings & guest support requests)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@zanzirangihouse.com
SMTP_PASS=<hostinger-email-password>
ALERT_NOTIFICATION_EMAIL=info@zanzirangihouse.com

