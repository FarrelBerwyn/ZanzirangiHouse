# ==============================================================================
# Zanzirangi House - Environment Configuration Template
# ==============================================================================
# IMPORTANT:
# 1. Never commit real credentials, database passwords, or JWT secrets to Git.
# 2. For local development, copy this file to .env.local (default: DATABASE_PROVIDER=json).
# 3. For Hostinger production, configure these variables in hPanel Node.js Application.
# ==============================================================================

NODE_ENV=production
APP_URL=https://zanzirangihouse.com
PUBLIC_URL=https://zanzirangihouse.com
API_URL=https://zanzirangihouse.com/api

# Database Provider: 'json' (development) | 'mysql' (production on Hostinger)
DATABASE_PROVIDER=mysql

# Hostinger MySQL Database Credentials (obtain from hPanel -> Databases -> MySQL Databases)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=u123456789_zanzirangi
DB_USER=u123456789_admin
DB_PASSWORD=

# Also compatible with MYSQL_* aliases:
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DATABASE=u123456789_zanzirangi
# MYSQL_USER=u123456789_admin
# MYSQL_PASSWORD=

# Administrative Authentication & Security
# Generate a strong 64-character random string (e.g. openssl rand -hex 32)
JWT_SECRET=
JWT_EXPIRES_IN=7d

ADMIN_EMAIL=info@zanzirangihouse.com

# Media & Storage Uploads
MEDIA_STORAGE_PATH=./uploads
MAX_UPLOAD_SIZE=25

# Network & Logging
CORS_ORIGIN=https://zanzirangihouse.com
LOG_LEVEL=info
