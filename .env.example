# ==============================================================================
# ZANZIRANGI HOUSE — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
#
# IMPORTANT:
# - Copy this file to .env for local development or set these variables in
#   the Hostinger Web App / Cloud panel for production.
# - NEVER commit real production secrets, passwords, or tokens to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# Values: 'development' | 'production' | 'test'
NODE_ENV=development

# The public canonical URL of the application
# Local:       http://localhost:3000
# Production:  https://zanzirangihouse.com
APP_URL=http://localhost:3000

# Server HTTP Port
PORT=3000

# Base URL for Express API
# Local:       http://localhost:3000/api
# Production:  https://zanzirangihouse.com/api
API_URL=http://localhost:3000/api

# CORS Allowed Origin
# Local:       http://localhost:3000
# Production:  https://zanzirangihouse.com
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. DATABASE PERSISTENCE ADAPTER
# ------------------------------------------------------------------------------
# Values: 'json' (local dev fallback) | 'mysql' (Hostinger production)
DATABASE_PROVIDER=json

# Hostinger MySQL Database Credentials (Required when DATABASE_PROVIDER=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=u123456789_zanzirangi
MYSQL_USER=u123456789_admin
MYSQL_PASSWORD=replace_with_secure_hostinger_db_password

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT SECURITY
# ------------------------------------------------------------------------------
# High-entropy secret key for signing JSON Web Tokens (min 32 characters in production)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_secure_cryptographic_secret_min_32_chars

# Session expiration duration (e.g., '7d', '24h')
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. INITIAL ADMIN BOOTSTRAP (SAFE METADATA ONLY)
# ------------------------------------------------------------------------------
# Authorized Zanzirangi Business Mailbox for primary CMS superadmin
ADMIN_EMAIL=info@zanzirangihouse.com

# NOTE: Passwords must NEVER be placed in this file.
# To create or rotate admin credentials securely, run:
#   npm run admin:create
# which prompts for credentials interactively and writes ONLY a bcrypt hash (cost 12).

# ------------------------------------------------------------------------------
# 5. PERSISTENT MEDIA STORAGE
# ------------------------------------------------------------------------------
# Path on disk where uploaded media files (images, documents) will be saved.
# MUST reside outside the compiled frontend 'dist/' directory to prevent
# media loss during application code redeployments.
#
# Local Default:       ./uploads
# Hostinger Example:   /home/u123456789/domains/zanzirangihouse.com/persistent/uploads
MEDIA_STORAGE_PATH=./uploads

# Maximum upload file size in bytes (e.g. 10MB = 10485760)
MAX_UPLOAD_SIZE_BYTES=10485760

# Maximum video upload size in bytes (e.g. 50MB = 52428800)
MAX_VIDEO_UPLOAD_SIZE_BYTES=52428800

# ------------------------------------------------------------------------------
# 6. LOGGING & TELEMETRY
# ------------------------------------------------------------------------------
# Values: 'debug' | 'info' | 'warn' | 'error'
LOG_LEVEL=info
